---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getPosts, slugOf, humanDate, ymd, isoWithOffset, heroFor, CATEGORY_LABEL, SITE, type Post,
} from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: slugOf(post) },
    props: { post, all: posts },
  }));
}

interface Props { post: Post; all: Post[] }
const { post, all } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const slug = slugOf(post);
const path = `/blog/${slug}`;
const url = `${SITE}${path}`;
const hero = heroFor(slug);
const ogImage = hero.src;
const imageUrl = `${SITE}${ogImage}`;
const published = isoWithOffset(d.pubDate);
const modified = isoWithOffset(d.updatedDate ?? d.pubDate);

const related = all
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    p,
    score:
      p.data.tags.filter((t) => d.tags.includes(t)).length * 2 +
      (p.data.category === d.category ? 1 : 0),
  }))
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((r) => r.p);

const org = { '@type': 'Organization', name: 'Signward', url: SITE };
const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  image: imageUrl,
  datePublished: published,
  dateModified: modified,
  author: org,
  publisher: { ...org, logo: { '@type': 'ImageObject', url: `${SITE}/og/default.png` } },
  mainEntityOfPage: url,
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}/blog` },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
};
---
<BaseLayout
  title={`${d.title} | Signward`}
  description={d.description}
  path={path}
  ogType="article"
  ogImage={ogImage}
  ogImageSize={hero.isHero ? [1536, 1024] : [1200, 630]}
  published={published}
  modified={modified}
  article
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <main class="page">
    <article class="narrow">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/blog">Blog</a></li>
          <li aria-current="page">{d.title}</li>
        </ol>
      </nav>
      <h1 class="page-title">{d.title}</h1>
      <p class="byline">
        <span class="cat">{CATEGORY_LABEL[d.category]}</span>
        <time datetime={ymd(d.pubDate)}>{humanDate(d.pubDate)}</time>
        <span>By Signward</span>
        {d.updatedDate && (
          <span>Updated <time datetime={ymd(d.updatedDate)}>{humanDate(d.updatedDate)}</time></span>
        )}
      </p>

      <img class="hero" src={hero.src} width={hero.isHero ? 1536 : 1200} height={hero.isHero ? 1024 : 630} alt={d.title} loading="eager" />

      <div class="prose"><Content /></div>

      {d.sources.length > 0 && (
        <section class="aside" id="sources">
          <h2>Sources</h2>
          <ul>
            {d.sources.map((s) => (
              <li><a href={s.url} rel="noopener nofollow" target="_blank">{s.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      <section class="aside" id="related">
        <h2>Related</h2>
        <ul>
          {related.length > 0
            ? related.map((p) => <li><a href={`/blog/${slugOf(p)}`}>{p.data.title}</a></li>)
            : <li><a href="/blog">More on the Signward security blog</a></li>}
        </ul>
      </section>
    </article>
  </main>
</BaseLayout>
